      "text": "```python\n    lines = path.read_text(encoding=\"utf-8\").splitlines()\n    cases: list[PromptCase] = []\n    seen_ids: set[str] = set()\n    for idx, line in enumerate(lines, start=1):\n        stripped = line.strip()\n        if not stripped:\n            continue\n        try:\n            raw = json.loads(stripped)\n        except json.JSONDecodeError as e:\n            raise ValueError(f\"Invalid JSON at line {idx}: {e}\") from e\n        if not isinstance(raw, dict):\n            raise ValueError(f\"Line {idx}: expected JSON object, got {type(raw).__name__}\")\n        missing = [k for k in (\"id\", \"category\", \"prompt\") if k not in raw]\n        if missing:\n            raise ValueError(f\"Line {idx}: missing required fields: {missing}\")\n        pid: str = str(raw[\"id\"])\n        category: str = str(raw[\"category\"])\n        prompt: str = str(raw[\"prompt\"])\n        max_tokens: int = int(raw.get(\"max_tokens\", 128))\n        notes: str = str(raw.get(\"notes\", \"\"))\n        if pid in seen_ids:\n            raise ValueError(f\"Line {idx}: duplicate prompt id '{pid}'\")\n        seen_ids.add(pid)\n        cases.append(\n            PromptCase(\n                id=pid,\n                category=category,\n                prompt=prompt,\n                max_tokens=max_tokens,\n                notes=notes,\n            )\n        )\n    return cases\n\n\ndef to_jsonl(cases: Iterable[PromptCase]) -> str:\n    \"\"\"Serialize cases to JSONL format.\"\"\"\n    return \"\\n\".join(json.dumps(asdict(c), ensure_ascii=False) for c in cases) + \"\\n\"\n\n\ndef save_prompt_suite(cases: Iterable[PromptCase], path: Path) -> None:\n    \"\"\"Write prompt suite to JSONL file atomically.\"\"\"\n    content = to_jsonl(cases)\n    tmp = path.with_suffix(path.suffix + \".tmp\")\n    tmp.write_text(content, encoding=\"utf-8\")\n    tmp.replace(path)\n\n\ndef filter_by_category(cases: list[PromptCase], category: str) -> list[PromptCase]:\n    return [c for c in cases if c.category == category]\n```",
