          "text": "```python\ndef load_prompt_suite(path: Path) -> list[PromptCase]:\n    \"\"\"Load a JSONL prompt suite and validate required fields.\"\"\"\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found: {path}\")\n\n    cases: list[PromptCase] = []\n    seen_ids: set[str] = set()\n    line_numbers: list[int] = []\n\n    with path.open(\"r\", encoding=\"utf-8\") as fh:\n        for lineno, line in enumerate(fh, start=1):\n            stripped = line.strip()\n            if not stripped:\n                continue\n\n            try:\n                raw: dict[str, Any] = json.loads(stripped)\n            except json.JSONDecodeError as exc:\n                raise ValueError(f\"Invalid JSON at line {lineno}: {exc}\") from exc\n\n            if not isinstance(raw, dict):\n                raise ValueError(f\"Line {lineno} must be a JSON object\")\n\n            required = {\"id\", \"category\", \"prompt\"}\n            missing = required - raw.keys()\n            if missing:\n                raise ValueError(f\"Line {lineno} missing required fields: {sorted(missing)}\")\n\n            cid: str = str(raw[\"id\"])\n            if cid in seen_ids:\n                raise ValueError(f\"Duplicate case id '{cid}' at line {lineno}\")\n            seen_ids.add(cid)\n\n            category: str = str(raw[\"category\"])\n            prompt: str = str(raw[\"prompt\"])\n            max_tokens_raw = raw.get(\"max_tokens\", 128)\n            try:\n                max_tokens = int(max_tokens_raw)\n            except (TypeError, ValueError) as exc:\n                raise ValueError(f\"Line {lineno}: invalid max_tokens {max_tokens_raw!r}\") from exc\n            if max_tokens <= 0:\n                raise ValueError(f\"Line {lineno}: max_tokens must be positive\")\n\n            notes: str = str(raw.get(\"notes\", \"\"))\n\n            case = PromptCase(id=cid, category=category, prompt=prompt, max_tokens=max_tokens, notes=notes)\n            cases.append(case)\n            line_numbers.append(lineno)\n\n    if not cases:\n        raise ValueError(f\"Prompt suite at {path} contains no cases\")\n\n    return cases\n\n\ndef build_eval_matrix(\n    cases: Iterable[PromptCase],\n    model_ids: Iterable[str],\n   ",
